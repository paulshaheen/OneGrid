.create-or-alter function with (skipvalidation = "true") ParsePiEvent() {
    PiEventsRaw
    | where isnotempty(tag) and tag != "forwarder.heartbeat"
    | project
        Ts           = ts,
        WebId        = webId,
        Tag          = tag,
        Plant        = plant,
        Value        = value,
        ValueType    = valueType,
        Questionable = questionable,
        Substituted  = substituted,
        Source       = source,
        Host         = host,
        IngestedAt   = now()
}
.create-or-alter function with (skipvalidation = "true") ParseIcareEvent() { IcareEventsRaw | project measurementId, icare_id, asset_id, asset_name, gds, acqend, date_key, value, status, res_type, global_type, analysis_status, technology, analysis_measured_date, IngestedAt=now() }
.create-or-alter function with (skipvalidation = "true") ParseGadsEvent() { GadsEventsRaw | project event_uid, GEN_SEQ_NO, UNIT_ID, UNIT_NAME, plant, REAL_START_DT, REAL_END_DT, DURATION_HRS, EVENT_YEAR, EVENT_MONTH, EVENT_TYPE_CD, EVENT_TYPE_DESC, EVENT_CAUSE_CD, CAUSE_CODE_DESC, AVAIL_CAP_DURING, AVAIL_CAP_AFTER, DERATING, IngestedAt=now() }
.create-or-alter function with (skipvalidation = "true") RouteIcareEvents() { PiEventsRaw | where _sourceType == 'icare' | project measurementId, icare_id, asset_id, asset_name, gds, acqend, date_key, value=toreal(value), status=toint(status), res_type, global_type, analysis_status='', technology='', analysis_measured_date=datetime(null), IngestedAt=now() }
.create-or-alter function with (skipvalidation = "true") RouteGadsEvents() { PiEventsRaw | where _sourceType == 'gads' | project event_uid, GEN_SEQ_NO, UNIT_ID, UNIT_NAME, plant, REAL_START_DT, REAL_END_DT, DURATION_HRS, EVENT_YEAR, EVENT_MONTH, EVENT_TYPE_CD, EVENT_TYPE_DESC, EVENT_CAUSE_CD, CAUSE_CODE_DESC, AVAIL_CAP_DURING, AVAIL_CAP_AFTER, DERATING, IngestedAt=now() }
.create-or-alter function with (skipvalidation = "true") ParseSmartSignalIncident() {
    SmartSignalIncidentsRaw
    | project
        incident_id, asset_id, asset_path, status, priority,
        message, tag_name, data_source_tag, tag_description, tag_unit,
        model_name, rule_name,
        first_occurred, last_occurred, occurrence_count,
        latest_actual, latest_estimate, latest_residual,
        snapshot_ts,
        IngestedAt = now()
}
.create-or-alter function with (skipvalidation = "true") ParseSmartSignalDiagnostic() {
    SmartSignalDiagnosticsRaw
    | project
        incident_id, tag_role, tag_name, source_tag,
        actual_value, expected_value, measurement_unit,
        last_change, snapshot_ts,
        IngestedAt = now()
}
.create-or-alter function with (skipvalidation = "true") ParseSmartSignalObservation() {
    SmartSignalObservationsRaw
    | project
        asset_id, asset_path, tag_name, tag_id,
        timestamp, actual_value, expected_value, residual,
        model_name, snapshot_ts,
        IngestedAt = now()
}

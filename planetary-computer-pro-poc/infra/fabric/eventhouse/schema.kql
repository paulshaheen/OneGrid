.create-or-alter function with (folder = "ml", docstring = "Asset-level risk summary - updated 2026-08-12 07:15 CT", skipvalidation = "true") WatchAssets() {
    datatable(asset_id:string, risk_level:string, cox_survival_7d:real, cox_survival_14d:real,
              short_term_stop_prob_4h:real, short_term_alert:string, scored_at:datetime)
    [
    "RV3_U3_Boiler_Feed_Pump_East", "MEDIUM", real(0.738), real(0.586), real(0.0), "UNKNOWN", datetime(2026-08-12T07:15:17Z),
    "RV2_U2_Boiler", "MEDIUM", real(0.734), real(0.564), real(0.535), "MEDIUM", datetime(2026-08-12T07:15:17Z),
    "RV3_U3_Steam_Turbine", "MEDIUM", real(0.729), real(0.572), real(0.026), "NORMAL", datetime(2026-08-12T07:15:17Z)
    ]
}
.create-or-alter function with (skipvalidation = "true") ParsePCIOutage() {
    PCIOutagesRaw
    | project
        outage_id, unit_name, unit_id, outage_type, status,
        start_date = todatetime(start_date),
        end_date = todatetime(end_date),
        duration_hrs, cause_code, cause_description,
        mw_capability, mw_reduction,
        description, miso_status,
        plant, priority, iso_id, action,
        modified_on = todatetime(modified_on),
        modified_by,
        snapshot_ts,
        IngestedAt = now()
}
.create-or-alter function with (skipvalidation = "true") ParseAimmWorkRequest() { AimmWorkRequestsRaw | project wr_id, problem_descr, problem_location, location, wr_type, wr_type_code, wr_status, wr_status_id, site_code, site_name, priority, priority_code, priority_rank, planner, pm_identifier, pm_descr, pm_due_date, safety_related, environ_related, unit_status, unit_status_id, offline_status, offline_status_id, elec_hrs, mech_hrs, ic_hrs, other_hrs, total_hrs, estimate_hrs, obsrv_date, start_date, complete_date, condition, condition_code, entity_identity, entity_descr, parent_identity, parent_descr, create_date, update_date, source_host, IngestedAt = now() }
.create-or-alter function with (skipvalidation = "true") ParseAimmEntityHierarchy() { AimmEntityHierarchyRaw | project hieroi, siteoi, mtnoi, entity_id, entity_descr, entity_type, bom_no, priority, department, level1_mtnoi, level2_mtnoi, level3_mtnoi, level4_mtnoi, level5_mtnoi, level6_mtnoi, level7_mtnoi, level8_mtnoi, update_date, source_host, IngestedAt = now() }

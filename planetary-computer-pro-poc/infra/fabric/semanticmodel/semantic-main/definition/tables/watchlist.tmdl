		changedProperty = Name

	measure 'Is Top Anomaly Tag' = ```
			
			 VAR _TopTags = 
			     TOPN(
			         10,
			         ALLSELECTED(bridge_pi_tag_to_asset[Tag]),
			         CALCULATE(MAX(aakr_scores[z_residual]))
			     )
			 RETURN
			     IF(
			         SELECTEDVALUE(bridge_pi_tag_to_asset[Tag]) IN _TopTags,
			         1, 0
			     )
			```
		formatString: 0
		lineageTag: d3cd5b4c-f80c-4bf9-9f14-693e54fa32ab

		changedProperty = Name

	measure 'Hours Since Last Run' = ```
			
			 VAR LastRunCT = MAX(watchlist[model_run_timestamp]) - TIME(5, 0, 0)
			 RETURN
			     INT(DATEDIFF(LastRunCT, NOW() - TIME(5, 0, 0), MINUTE) / 60) & "h " &
			     MOD(DATEDIFF(LastRunCT, NOW() - TIME(5, 0, 0), MINUTE), 60) & "m ago"
			```
		lineageTag: 8c5cb377-d89a-48b0-afba-9edb37b9f6f1

		changedProperty = Name


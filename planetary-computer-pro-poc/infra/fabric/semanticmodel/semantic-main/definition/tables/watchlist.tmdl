	measure 'System Health' = ```
			
			 VAR _latestRuns = 
			     SUMMARIZE(
			         watchlist,
			         watchlist[model_name],
			         "LatestRun", MAX(watchlist[model_run_timestamp])
			     )
			 VAR _latestRows = 
			     FILTER(
			         watchlist,
			         COUNTROWS(
			             FILTER(
			                 _latestRuns,
			                 [model_name] = watchlist[model_name]
			                     && [LatestRun] = watchlist[model_run_timestamp]
			             )
			         ) > 0
			     )
			 VAR _critical = 
			     COUNTROWS(
			         FILTER(_latestRows, watchlist[recommended_action] IN {"CRITICAL", "HIGH"})
			     )
			 VAR _moderate = 
			     COUNTROWS(
			         FILTER(_latestRows, watchlist[recommended_action] IN {"MEDIUM", "INVESTIGATE"})
			     )
			 RETURN
			     SWITCH(
			         TRUE(),
			         _critical > 0, UNICHAR(128308) & " Critical",
			         _moderate > 0, UNICHAR(128993) & " Moderate",
			         UNICHAR(128994) & " Healthy"
			     )
			```
		lineageTag: 9f5287ba-37ed-4c7e-8780-20e9840671c8

		changedProperty = Name

	measure 'PI Last Refresh Date' = ```
			
			 MAX(fact_pi[Timestamp]) - TIME(5, 0, 0)
			```
		formatString: General Date
		lineageTag: bc17abfc-ce19-4b57-87d9-e1fb23926491

		changedProperty = Name

	measure 'Cox 14d Downtime' = ```
			
			 VAR _LatestTs = MAX(predictions_longterm[scoring_timestamp])
			 VAR _Surv = 
			     CALCULATE(
			         AVERAGE(predictions_longterm[survival_probability_14d]),
			         predictions_longterm[scoring_timestamp] = _LatestTs
			     )
			 VAR _Pct = 1 - _Surv
			 VAR _Risk = 
			     CALCULATE(
			         LASTNONBLANK(predictions_longterm[risk_level], 1),
			         predictions_longterm[scoring_timestamp] = _LatestTs
			     )
			 VAR _Icon = 
			     SWITCH(_Risk, 
			         "HIGH", UNICHAR(128308),
			         "MEDIUM", UNICHAR(128993),
			         UNICHAR(128994)
			     )
			 RETURN
			     _Icon & " " & FORMAT(_Pct, "0.0%")
			```
		lineageTag: 667c914f-d7da-4997-9c68-25ad64c2508d

		changedProperty = Name

	measure 'Last Model Run (CT)' = ```
			
			 FORMAT(
			     MAX(watchlist[model_run_timestamp]) - TIME(5, 0, 0),
			     "MM/DD/YYYY h:mm AM/PM"
			 )
			```
		lineageTag: f2a00384-9de8-41ac-a8c1-898a51a298aa

		changedProperty = Name

	measure 'Max 4h Stop Display' = ```
			
			 VAR _Latest = MAX(predictions_shortterm[scoring_timestamp])
			 VAR _Pct = 
			     CALCULATE(
			         MAX(predictions_shortterm[stop_probability]),
			         predictions_shortterm[scoring_timestamp] = _Latest,
			         predictions_shortterm[prediction_horizon] = "4h"
			     )
			 VAR _Icon = 
			     SWITCH(TRUE(),
			         _Pct >= 0.5, UNICHAR(128308),
			         _Pct >= 0.25, UNICHAR(128993),
			         UNICHAR(128994)
			     )
			 RETURN
			     _Icon & " " & FORMAT(_Pct, "0.0%")
			
			```
		lineageTag: d55a62bc-1a3b-48e0-9b3f-80a601134fa9

		changedProperty = Name


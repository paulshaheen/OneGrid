table watchlist
	lineageTag: bb04a93a-74f6-4890-b568-cc666713c0ff
	sourceLineageTag: [ml].[watchlist]

	measure 'Total Critical Alerts' = ```
			
			 VAR _latestRuns = 
			     SUMMARIZE(
			         watchlist,
			         watchlist[model_name],
			         "LatestRun", MAX(watchlist[model_run_timestamp])
			     )
			 VAR _latestRows = 
			     FILTER(
			         watchlist,
			         COUNTROWS(
			             FILTER(
			                 _latestRuns,
			                 [model_name] = watchlist[model_name]
			                     && [LatestRun] = watchlist[model_run_timestamp]
			             )
			         ) > 0
			     )
			 VAR _count = COUNTROWS(FILTER(_latestRows, watchlist[recommended_action] = "CRITICAL")) + 0
			 RETURN
			     IF(_count > 0, UNICHAR(128308) & " " & _count, UNICHAR(128994) & " 0")
			```
		lineageTag: a6ba3ac9-de25-4cf1-a63a-1809657f8499

		changedProperty = Name

	measure 'Survival Risk' = MAX(predictions_longterm[risk_score])
		lineageTag: 6ea5c9c2-e9c9-40c6-ad69-087d0ec34c73

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Sensors Above Threshold' = COUNTROWS(FILTER(aakr_scores, ABS(aakr_scores[z_residual]) > 3))
		formatString: 0
		lineageTag: 008e941d-ba5a-457b-9c17-165cac258105

		changedProperty = Name

	measure 'RV2 Unit Status' = ```
			
			 VAR _latestTS = 
			     CALCULATE(
			         MAX(fact_pi[Timestamp]),
			         fact_pi[Tag] = "RV2:BTPU2BP20.AG"
			     )
			 VAR _latestValue = 
			     CALCULATE(
			         MAX(fact_pi[ValueNumeric]),
			         fact_pi[Tag] = "RV2:BTPU2BP20.AG",
			         fact_pi[Timestamp] = _latestTS
			     )
			 RETURN IF(_latestValue > 600, "Running", "Stopped")
			```
		lineageTag: 05716cbd-7bfb-45cc-b2a8-c0a839e17b4b

		changedProperty = Name


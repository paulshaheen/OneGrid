# --- Aurora endpoint (the deployed Azure ML online endpoint) --------------------
# Scoring URI, e.g. https://pcpro-aml-xxxx-yyyy.westeurope.inference.ml.azure.com/score
AURORA_ENDPOINT=
# Endpoint key or AAD token. Never commit the real value.
AURORA_ENDPOINT_TOKEN=
# Checkpoint to run. Leave blank to auto-select the one valid for the IC source
# (finetuned for hres_t0/hres, pretrained for era5).
AURORA_MODEL_NAME=
# Number of 6-hour forecast steps to request (20 steps = 120 h, matching the app horizon).
AURORA_NUM_STEPS=20

# --- Blob transfer channel (Aurora passes tensors via blob, not HTTP body) ------
# Option A: a container URL WITH a read/write SAS token for the endpoint scratch.
AURORA_BLOB_CHANNEL_URL=
# Option B (recommended on Azure): let the job mint a short-lived user-delegation
# SAS with its managed identity. Set the account URL + container instead of a SAS.
AURORA_BLOB_ACCOUNT_URL=
AURORA_BLOB_CONTAINER=

# --- Initial conditions ---------------------------------------------------------
# "hres_t0" (default, public WeatherBench2 + HuggingFace static — NO credentials),
# "era5" (Copernicus CDS, requires ~/.cdsapirc), or "hres" (local GRIB files).
INITIAL_CONDITION_SOURCE=hres_t0
# hres_t0: the public archive to read. The default covers 2016-2022; set
# ANALYSIS_TIME within that range, or point this at a dataset covering your time.
AURORA_WB2_ZARR_URL=gs://weatherbench2/datasets/hres_t0/2016-2022-6h-1440x721.zarr
# hres_t0: Aurora's static variables on HuggingFace (no credentials needed).
AURORA_STATIC_REPO=microsoft/aurora
AURORA_STATIC_NAME=aurora-0.25-static.pickle
# For INITIAL_CONDITION_SOURCE=hres: directory containing the two-timestep GRIB files.
HRES_INPUT_DIR=
# Explicit analysis time (UTC ISO, e.g. 2022-09-26T00:00:00). Required in practice
# for hres_t0 because the public archive is historical, not real-time.
ANALYSIS_TIME=

# --- Detection domain (limit tracking to the operating region) ------------------
# minLon,minLat,maxLon,maxLat. Default is the Gulf of Mexico / western Atlantic.
DETECTION_BBOX=-100,15,-70,35

# --- Output ---------------------------------------------------------------------
# The model-outputs container URL (no SAS) — used with managed identity on Azure.
OUTPUT_CONTAINER_URL=
# Local / non-managed-identity alternative: full SAS URL to the output container.
OUTPUT_SAS_URL=
# Blob name the web app reads.
OUTPUT_BLOB_NAME=weather-events.json

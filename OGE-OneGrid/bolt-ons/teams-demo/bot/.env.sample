# --- OneGrid Teams demo bot configuration ---

# The deployed OneGrid app (the container app that serves the dashboard + chat API).
# This is where the bot forwards every question. No trailing slash.
ONEGRID_APP_URL=https://onegrid-app-75033e-chat.niceisland-20053c21.eastus2.azurecontainerapps.io

# Azure Bot identity (from the Azure Bot resource / app registration created by deploy.ps1).
# The Microsoft 365 Agents SDK reads these names (case-insensitive). Leave blank to run
# locally against the Bot Framework Emulator with no auth.
authType=ClientSecret
clientId=
clientSecret=
tenantId=

# Port the bot listens on for /api/messages (Container Apps ingress targets this).
PORT=3978

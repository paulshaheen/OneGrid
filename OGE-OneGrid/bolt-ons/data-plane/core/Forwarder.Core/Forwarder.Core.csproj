<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Forwarder.Core — the source-agnostic reliability core shared by every data-plane
    connector (PI, SQL/Oracle db-forwarder, ...). Contains the durable SQLite outbox,
    the Fabric Eventstream publisher (AMQP + cert auth), the drain/heartbeat loops, the
    canonical event shape, and the shared options. Connectors add only a source-read loop.
  -->

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Forwarder.Core</RootNamespace>
    <AssemblyName>Forwarder.Core</AssemblyName>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="8.0.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.10" />
    <PackageReference Include="Azure.Identity" Version="1.13.1" />
    <PackageReference Include="Azure.Messaging.EventHubs" Version="5.11.5" />
  </ItemGroup>

</Project>

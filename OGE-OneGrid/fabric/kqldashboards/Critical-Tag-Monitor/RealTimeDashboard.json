  "queries": [
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "793f0ae3-ae0b-4761-a8c5-6117c283db51"
      },
      "text": "let rv2=PiEvents|where not(Questionable) and Tag==\"RV2:BTPU2BPDRUM.AG\"|top 1 by Ts desc|extend Asset=\"RV2 Unit 2 Boiler\",Indicator=\"Drum Pressure\",Units=\"PSI\",Threshold=600;\nlet rv3=PiEvents|where not(Questionable) and Tag==\"RV3:TXSU3TS15A.AG\"|top 1 by Ts desc|extend Asset=\"RV3 Unit 3 Steam Turbine\",Indicator=\"Turbine Speed\",Units=\"RPM\",Threshold=6;\nunion rv2,rv3\n|extend V=toreal(Value)\n|extend Status=case(V>Threshold,\"RUNNING\",\"STOPPED\")\n|project Asset, Status, Value=round(V,1), Indicator, Units, LastReading=Ts\n| order by Asset asc",
      "id": "2e148780-b537-4201-adee-1203632eb503",
      "usedVariables": []
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "793f0ae3-ae0b-4761-a8c5-6117c283db51"
      },
      "text": "WatchAssets()\n| project Asset=asset_id, Risk=risk_level,\n          Value=round(cox_survival_14d*100,1)",
      "id": "95a7fb29-7950-4af1-98fa-157a895c4424",
      "usedVariables": []
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "793f0ae3-ae0b-4761-a8c5-6117c283db51"
      },
      "text": "PiEvents\n| where Ts > ago(24h) and not(Questionable)\n| where Tag in (WatchTags() | where watch_priority in (\"CRITICAL\",\"HIGH\") | project tag)\n| lookup (WatchTags() | project tag, descriptor) on $left.Tag == $right.tag\n| summarize Value=avg(toreal(Value)) by bin(Ts, 5m), descriptor",
      "id": "361a9e20-b432-4c5e-b5a9-f9e3dcf579f7",
      "usedVariables": []
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "793f0ae3-ae0b-4761-a8c5-6117c283db51"
      },
      "text": "WatchTags()\n| summarize Tags=count() by asset_id, watch_priority",
      "id": "61bf84eb-9f82-48f0-ac74-7bfcd273f519",
      "usedVariables": []
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "793f0ae3-ae0b-4761-a8c5-6117c283db51"
      },
      "text": "let wt = WatchTags();\nlet current = PiEvents\n| where Ts > ago(1h) and not(Questionable)\n| where Tag in (wt | project tag)\n| summarize CurrentValue=round(avg(toreal(Value)),2), LastReading=max(Ts) by Tag;\ncurrent\n| join kind=inner wt on $left.Tag == $right.tag\n| project Sensor=descriptor, CurrentValue, Units=engineering_units,\n          Priority=watch_priority, Sources=signal_sources,\n          Models=model_agreement_count, Action=recommended_action\n| order by Priority asc, Models desc",
      "id": "927011a0-e804-4434-ab85-8c7289fb2f1f",
      "usedVariables": []
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "793f0ae3-ae0b-4761-a8c5-6117c283db51"
      },
      "text": "WatchTags()\n| where risk_score > 0\n| top 15 by risk_score desc\n| project Sensor=descriptor, risk_score=round(risk_score,2)",
      "id": "dfa54c2c-a1b2-40eb-b138-1c6a9e70674c",
      "usedVariables": []
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "793f0ae3-ae0b-4761-a8c5-6117c283db51"
      },
      "text": "let wt = WatchTags() | where watch_priority in (\"CRITICAL\",\"HIGH\") | project tag, descriptor;\nlet baselines = PiEvents\n| where Ts between (ago(30d) .. ago(1d)) and not(Questionable)\n| where Tag in (wt | project tag)\n| summarize Mean=avg(toreal(Value)), Std=stdev(toreal(Value)) by Tag;\nPiEvents\n| where Ts > ago(7d) and not(Questionable)\n| where Tag in (wt | project tag)\n| summarize DailyAvg=avg(toreal(Value)) by Day=bin(Ts, 1d), Tag\n| join kind=leftouter baselines on Tag\n| join kind=leftouter wt on $left.Tag == $right.tag\n| extend ZScore=round((DailyAvg - Mean) / Std, 2)\n| project Timestamp=Day, descriptor, ZScore",
      "id": "4c6b7004-d87d-45c8-93fe-030f4d79c183",
      "usedVariables": []
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "793f0ae3-ae0b-4761-a8c5-6117c283db51"
      },
      "text": "PiEvents\n| where Ts > ago(1h) and not(Questionable)\n| where Tag in (WatchTags() | project tag)\n| summarize Readings=count(), ActiveTags=dcount(Tag),\n            LatestReading=max(Ts),\n            LagSeconds=datetime_diff('second', now(), max(Ts))\n| extend Status=case(LagSeconds < 60, \"LIVE\", LagSeconds < 300, \"DELAYED\", \"STALE\")",
      "id": "8cd33dc4-75af-482d-b361-cd097523a185",
      "usedVariables": []
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "793f0ae3-ae0b-4761-a8c5-6117c283db51"
      },
      "text": "let crit = datatable(Tag:string, Descriptor:string, Risk:real)[\n    \"RV2:TXSU2TS14.AG\",\"Tsi Turb Speed\",2855.7610,\n    \"RV2:FLZU2HLV51XFB.AG\",\"Heater Lvl Vv 51 X Feedback\",2135.7175,\n    \"RV2:FLZU2HLV51XD.AG\",\"Heater Lvl Vv 51 X Demand\",1854.9820,\n    \"RV3:FPSU3TS24E.AG\",\"3E Bfpp  Speed\",1792.9870,\n    \"RV3:TXSU3TS15A1.AG\",\"Unit 3 Turbine Speed\",965.1263\n];\nlet baseline = PiEvents\n| where Tag in (crit | project Tag) and not(Questionable) and Ts between (ago(14d) .. ago(1h))\n| summarize Expected=avg(toreal(Value)), Std=stdev(toreal(Value)) by Tag;\nPiEvents\n| where Tag in (crit | project Tag) and not(Questionable) and IngestedAt > ago(10m)\n| summarize arg_max(Ts, Value) by Tag\n| join kind=inner crit on Tag\n| join kind=leftouter baseline on Tag\n| extend Actual=round(toreal(Value),2), Expected=round(Expected,2)\n| extend Deviation=round(Actual-Expected,2), Sigma=iff(isnull(Std) or Std<=0,real(null),round((Actual-Expected)/Std,1))\n| project Priority=\"CRITICAL\", Descriptor, Tag, Actual, Expected, Deviation, Sigma, RiskZ=round(Risk,1), Updated=Ts\n| order by RiskZ desc",
      "id": "c0ffee00-0000-0000-0000-000000000002",
      "usedVariables": []
    },
    {
      "dataSource": {

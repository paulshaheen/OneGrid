table aakr_scores
	lineageTag: d2ccb718-3f85-474d-ac40-c602c40604c4
	sourceLineageTag: [ml].[aakr_scores]

	measure 'Sustained Anomaly' = ```
			
			 IF(
			     CALCULATE(COUNTROWS(aakr_scores), aakr_scores[is_anomaly] = TRUE) >= 3,
			     "Anomaly",
			     "Normal"
			 )

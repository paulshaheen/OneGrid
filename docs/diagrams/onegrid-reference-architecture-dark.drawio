        <mxCell id="identity-gates-subtitle" parent="identity-gates" vertex="1" value="Record principal IDs, role scope, Fabric item/database grants, token audience, connection owner, rotation and denied-access tests. Do not infer access from matching display names, a successful sign-in, a private IP, or the existence of an&lt;br&gt;identity resource." style="fontFamily=Segoe UI;html=1;whiteSpace=wrap;text;align=left;verticalAlign=top;spacing=0;fontSize=17;fontColor=#B7C8DA;fontStyle=0;">

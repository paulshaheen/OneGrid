        <mxCell id="dns-test-subtitle" parent="dns-test" vertex="1" value="Resolve original app/SCM, Blob, OpenAI, ML inference, registry/data and Fabric hosts from gateway, app, job, runner and hybrid clients. Then test HTTPS/TDS, valid TLS/SNI, authorized data access and denied public origin. Test Blob and DFS&lt;br&gt;separately when ADLS uses both." style="fontFamily=Segoe UI;html=1;whiteSpace=wrap;text;align=left;verticalAlign=top;spacing=0;fontSize=17;fontColor=#B7C8DA;fontStyle=0;">

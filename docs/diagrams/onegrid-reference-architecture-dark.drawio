        <mxCell id="dns-ha-title" parent="dns-ha" vertex="1" value="Regional recovery is a configured design, not an automatic side effect" style="fontFamily=Segoe UI;html=1;whiteSpace=wrap;text;align=left;verticalAlign=top;spacing=0;fontSize=24;fontColor=#EDF5FF;fontStyle=1;">
          <mxGeometry x="20" y="17" width="2280" height="29" as="geometry" />

          <mxGeometry x="14" y="12" width="312" height="23" as="geometry" />
        </mxCell>
        <mxCell id="gfs-body" parent="gfs" vertex="1" value="Public S3 f000 0.25-degree analyses&lt;br&gt;Two cycles six hours apart&lt;br&gt;Select earlier cycle for data latency&lt;br&gt;Required fields / pressure levels" style="fontFamily=Segoe UI;html=1;whiteSpace=wrap;text;align=left;verticalAlign=top;spacing=0;fontSize=15;fontColor=#B7C8DA;fontStyle=0;">
          <mxGeometry x="14" y="40" width="312" height="80" as="geometry" />

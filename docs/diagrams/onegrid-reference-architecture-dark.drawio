            <mxGeometry x="540" y="290" width="640" height="220" as="geometry" />
          </mxCell>
        </object>
        <object id="user-scope" label="" tooltip="Application authorization&#10;Sign-in establishes user identity, not automatic row filtering across DAX, KQL, Data Agent or Blob.&#10;Test each tool/data path with permitted and denied users. A shared application identity can otherwise access the same backend data.">
          <mxCell parent="1" vertex="1" style="fontFamily=Segoe UI;html=1;whiteSpace=wrap;rounded=1;arcSize=5;container=1;collapsible=0;fillColor=#0F171F;strokeColor=#416780;strokeWidth=1.5;dashed=0;">
            <mxGeometry x="1240" y="290" width="1120" height="220" as="geometry" />
          </mxCell>
        </object>
        <object id="app" label="" tooltip="App Service identity&#10;System-assigned managed identity">
          <mxCell parent="1" vertex="1" style="fontFamily=Segoe UI;html=1;whiteSpace=wrap;rounded=1;arcSize=5;container=1;collapsible=0;fillColor=#0F171F;strokeColor=#416780;strokeWidth=1.5;dashed=0;">
            <mxGeometry x="40" y="580" width="440" height="220" as="geometry" />
          </mxCell>
        </object>
        <object id="app-credential" label="" tooltip="Identity / credential context&#10;Resource-specific Entra access tokens&#10;OpenAI also supports an explicitly configured API-key path&#10;HTTPS 443 through app's own network configuration">
          <mxCell parent="1" vertex="1" style="fontFamily=Segoe UI;html=1;whiteSpace=wrap;rounded=1;arcSize=5;container=1;collapsible=0;fillColor=#0F171F;strokeColor=#416780;strokeWidth=1.5;dashed=0;">

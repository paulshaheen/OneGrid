        <mxCell id="job-env-title" parent="job-env" vertex="1" value="Container Apps workload profiles environment" style="fontFamily=Segoe UI;html=1;whiteSpace=wrap;text;align=left;verticalAlign=top;spacing=0;fontSize=24;fontColor=#EDF5FF;fontStyle=1;">
          <mxGeometry x="64" y="17" width="636" height="29" as="geometry" />
        </mxCell>
        <mxCell id="job-env-subtitle" parent="job-env" vertex="1" value="Enterprise example: 10.20.4.0/23; own DNS, routes, firewall rules and&lt;br&gt;identity." style="fontFamily=Segoe UI;html=1;whiteSpace=wrap;text;align=left;verticalAlign=top;spacing=0;fontSize=17;fontColor=#B7C8DA;fontStyle=0;">
          <mxGeometry x="20" y="58" width="680" height="44" as="geometry" />
        </mxCell>
        <object id="entry" label="" tooltip="Start one job execution&#10;Python 3.11 / CPU torch; 2 vCPU / 4 GiB&#10;python -m aurora_pipeline.run&#10;Managed identity selected with AZURE_CLIENT_ID&#10;One cycle -&gt; exit; timeout 3600 s / retry limit 1">
          <mxCell parent="job-env" vertex="1" style="fontFamily=Segoe UI;html=1;whiteSpace=wrap;rounded=1;arcSize=5;container=1;collapsible=0;fillColor=#0F171F;strokeColor=#416780;strokeWidth=1.5;dashed=0;">
            <mxGeometry x="40" y="130" width="640" height="210" as="geometry" />
          </mxCell>
        </object>
        <object id="prepare" label="" tooltip="Prepare two starting weather states&#10;config.py + initial_conditions.py&#10;Temperature / wind / pressure / humidity; 13 pressure levels&#10;GFS unit/grid conversion + standard static fields&#10;Example: 13 UTC run uses 00 and 06 UTC snapshots">
          <mxCell parent="job-env" vertex="1" style="fontFamily=Segoe UI;html=1;whiteSpace=wrap;rounded=1;arcSize=5;container=1;collapsible=0;fillColor=#0F171F;strokeColor=#416780;strokeWidth=1.5;dashed=0;">
            <mxGeometry x="40" y="420" width="640" height="210" as="geometry" />
          </mxCell>
        </object>
        <object id="invoke" label="" tooltip="Detect, filter and submit forecast&#10;tracking.py / nhc.py / inference.py&#10;Pressure minima + nearby strong winds -&gt; candidate centres&#10;NHC matching / fallback filter -&gt; official aurora.Tracker seeds&#10;Request aurora-0.25-finetuned, 20 six-hour steps">
          <mxCell parent="job-env" vertex="1" style="fontFamily=Segoe UI;html=1;whiteSpace=wrap;rounded=1;arcSize=5;container=1;collapsible=0;fillColor=#0F171F;strokeColor=#416780;strokeWidth=1.5;dashed=0;">
            <mxGeometry x="40" y="810" width="640" height="210" as="geometry" />
          </mxCell>
        </object>
        <object id="normalize" label="" tooltip="Track and normalize for OneGrid&#10;Follow each seed through returned weather fields&#10;Starting position/intensity is from the input analysis&#10;Forecast positions / winds / pressure from rollout&#10;Convert units, movement and categories; publish events">
          <mxCell parent="job-env" vertex="1" style="fontFamily=Segoe UI;html=1;whiteSpace=wrap;rounded=1;arcSize=5;container=1;collapsible=0;fillColor=#0F171F;strokeColor=#416780;strokeWidth=1.5;dashed=0;">
            <mxGeometry x="40" y="1200" width="640" height="210" as="geometry" />
          </mxCell>
        </object>
        <mxCell id="ml-workspace" parent="1" vertex="1" style="fontFamily=Segoe UI;html=1;whiteSpace=wrap;rounded=1;arcSize=4;container=1;collapsible=0;fillColor=#19232D;strokeColor=#3D85AF;strokeWidth=1.5;dashed=0;">
          <mxGeometry x="1260" y="190" width="1100" height="1050" as="geometry" />
        </mxCell>
        <mxCell id="ml-workspace-icon" parent="ml-workspace" vertex="1" style="fontFamily=Segoe UI;html=1;whiteSpace=wrap;shape=image;aspect=fixed;imageAspect=1;image=data:image/svg+xml,;">
          <mxGeometry x="20" y="18" width="32" height="32" as="geometry" />
        </mxCell>
        <mxCell id="ml-workspace-title" parent="ml-workspace" vertex="1" value="Azure ML service-hosted workspace / deployment" style="fontFamily=Segoe UI;html=1;whiteSpace=wrap;text;align=left;verticalAlign=top;spacing=0;fontSize=24;fontColor=#EDF5FF;fontStyle=1;">
          <mxGeometry x="64" y="17" width="1016" height="29" as="geometry" />
        </mxCell>
        <mxCell id="ml-workspace-subtitle" parent="ml-workspace" vertex="1" value="Customer workspace private endpoint handles inbound; managed-network policy handles deployment outbound." style="fontFamily=Segoe UI;html=1;whiteSpace=wrap;text;align=left;verticalAlign=top;spacing=0;fontSize=17;fontColor=#B7C8DA;fontStyle=0;">
          <mxGeometry x="20" y="58" width="1060" height="22" as="geometry" />
        </mxCell>
        <object id="model" label="" tooltip="Model deployment and backing resources&#10;Workspace + endpoint existence is not model readiness: model asset / accepted terms / GPU quota / healthy deployment required.&#10;Default GPU: Standard_NC24ads_A100_v4; model selection is separate from the CPU image.&#10;Workspace identity, endpoint identity, AML backing storage, Key Vault and Application Insights have distinct lifecycle/permissions.&#10;Validate artifact pulls and required backing-resource roles; don't treat resource wiring as a completed permissions test.">
          <mxCell parent="ml-workspace" vertex="1" style="fontFamily=Segoe UI;html=1;whiteSpace=wrap;rounded=1;arcSize=5;container=1;collapsible=0;fillColor=#0F171F;strokeColor=#416780;strokeWidth=1.5;dashed=0;">
            <mxGeometry x="40" y="130" width="1020" height="220" as="geometry" />
          </mxCell>
        </object>
        <object id="ml-egress" label="" tooltip="Managed deployment outbound network&#10;For private enterprise operation: configure allowed outbound managed private endpoints / approved destinations.&#10;Include the customer Blob channel as well as ML backing storage / Key Vault / image artifacts.&#10;A user-delegation SAS authorizes Blob operations; it does not bypass a storage firewall.&#10;This policy is not the Container Apps environment subnet or App Service VNet integration.">
          <mxCell parent="ml-workspace" vertex="1" style="fontFamily=Segoe UI;html=1;whiteSpace=wrap;rounded=1;arcSize=5;container=1;collapsible=0;fillColor=#0F171F;strokeColor=#416780;strokeWidth=1.5;dashed=0;">
            <mxGeometry x="40" y="460" width="1020" height="210" as="geometry" />
          </mxCell>
        </object>
        <object id="gpu" label="" tooltip="Aurora managed online endpoint&#10;Job -&gt; workspace PE -&gt; supplied scoring hostname / HTTPS 443&#10;Endpoint authMode = AADToken; job token audience https://ml.azure.com&#10;Template job grant: AzureML Data Scientist on workspace&#10;Aurora predicts atmospheric fields; model is not trained anew per execution">

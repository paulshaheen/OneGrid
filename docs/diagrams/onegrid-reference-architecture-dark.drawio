          </mxCell>
        </object>
        <object id="deploy-scope" label="" tooltip="Provisioning, not runtime&#10;Template grants include resource-group Owner and storage User Access Administrator for provisioning tasks.&#10;Use approved release/elevation controls; keep credentials and administrative tooling out of runtime code. Review and remove unneeded standing grants after deployment.">
          <mxCell parent="1" vertex="1" style="fontFamily=Segoe UI;html=1;whiteSpace=wrap;rounded=1;arcSize=5;container=1;collapsible=0;fillColor=#0F171F;strokeColor=#416780;strokeWidth=1.5;dashed=0;">

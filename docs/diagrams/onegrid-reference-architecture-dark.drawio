        <mxCell id="producer-zone-subtitle" parent="producer-zone" vertex="1" value="Customer-controlled connector and&lt;br&gt;administrative network." style="fontFamily=Segoe UI;html=1;whiteSpace=wrap;text;align=left;verticalAlign=top;spacing=0;fontSize=17;fontColor=#B7C8DA;fontStyle=0;">
          <mxGeometry x="20" y="58" width="360" height="44" as="geometry" />

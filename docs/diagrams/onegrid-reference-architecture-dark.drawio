        <mxCell id="static-title" parent="static" vertex="1" value="HuggingFace static fields" style="fontFamily=Segoe UI;html=1;whiteSpace=wrap;text;align=left;verticalAlign=top;spacing=0;fontSize=18;fontColor=#EDF5FF;fontStyle=1;">
          <mxGeometry x="14" y="12" width="312" height="23" as="geometry" />
        </mxCell>
        <mxCell id="static-body" parent="static" vertex="1" value="microsoft/aurora static data&lt;br&gt;Land mask / elevation / soil&lt;br&gt;Allow actual download/CDN hosts&lt;br&gt;Not customer imagery" style="fontFamily=Segoe UI;html=1;whiteSpace=wrap;text;align=left;verticalAlign=top;spacing=0;fontSize=15;fontColor=#B7C8DA;fontStyle=0;">
          <mxGeometry x="14" y="40" width="312" height="80" as="geometry" />
        </mxCell>
        <mxCell id="nhc-title" parent="nhc" vertex="1" value="NHC active storm feed" style="fontFamily=Segoe UI;html=1;whiteSpace=wrap;text;align=left;verticalAlign=top;spacing=0;fontSize=17;fontColor=#EDF5FF;fontStyle=1;">
          <mxGeometry x="14" y="12" width="312" height="22" as="geometry" />
        </mxCell>
        <mxCell id="nhc-body" parent="nhc" vertex="1" value="Names and positions, not Aurora&lt;br&gt;predictions&lt;br&gt;Default match of detected candidates&lt;br&gt;Unavailable -&amp;gt; tropical-latitude filter" style="fontFamily=Segoe UI;html=1;whiteSpace=wrap;text;align=left;verticalAlign=top;spacing=0;fontSize=14;fontColor=#B7C8DA;fontStyle=0;">
          <mxGeometry x="14" y="39" width="312" height="76" as="geometry" />

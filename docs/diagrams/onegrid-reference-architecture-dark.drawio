        <mxCell id="producer-zone-title" parent="producer-zone" vertex="1" value="Source / connected client" style="fontFamily=Segoe UI;html=1;whiteSpace=wrap;text;align=left;verticalAlign=top;spacing=0;fontSize=24;fontColor=#EDF5FF;fontStyle=1;">

        <mxCell id="monitoring-network-title" parent="monitoring-network" vertex="1" value="Monitoring network and retention controls" style="fontFamily=Segoe UI;html=1;whiteSpace=wrap;text;align=left;verticalAlign=top;spacing=0;fontSize=24;fontColor=#EDF5FF;fontStyle=1;">
          <mxGeometry x="20" y="17" width="2280" height="29" as="geometry" />
        </mxCell>
        <mxCell id="monitoring-network-subtitle" parent="monitoring-network" vertex="1" value="If policy requires private Azure Monitor ingestion/query, design AMPLS, supported endpoints and private DNS for the chosen signals; a Log Analytics workspace alone is not private monitoring. Validate required agent/platform endpoints,&lt;br&gt;retention, access, redaction, alert delivery and the administration path." style="fontFamily=Segoe UI;html=1;whiteSpace=wrap;text;align=left;verticalAlign=top;spacing=0;fontSize=17;fontColor=#B7C8DA;fontStyle=0;">

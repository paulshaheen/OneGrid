          </mxCell>
        </object>
        <object id="app-scope" label="" tooltip="Runtime data and control grants&#10;Template: Storage Blob Data Contributor on sample account; GeoCatalog Administrator on catalog; Jobs Operator scoped to the one job.&#10;Provisioner applies Fabric/KQL/model and configured OpenAI grants. DAX/KQL/agent permissions remain distinct; verify actual runtime settings.">
          <mxCell parent="1" vertex="1" style="fontFamily=Segoe UI;html=1;whiteSpace=wrap;rounded=1;arcSize=5;container=1;collapsible=0;fillColor=#0F171F;strokeColor=#416780;strokeWidth=1.5;dashed=0;">
            <mxGeometry x="1240" y="580" width="1120" height="220" as="geometry" />
          </mxCell>

          <mxGeometry x="14" y="14" width="48" height="48" as="geometry" />
        </mxCell>
        <mxCell id="registry-title" parent="registry" vertex="1" value="Pipeline image / ACR" style="fontFamily=Segoe UI;html=1;whiteSpace=wrap;text;align=left;verticalAlign=top;spacing=0;fontSize=17;fontColor=#EDF5FF;fontStyle=1;">
          <mxGeometry x="76" y="12" width="250" height="22" as="geometry" />
        </mxCell>
        <mxCell id="registry-body" parent="registry" vertex="1" value="Image pull before Python starts&lt;br&gt;Own job identity / AcrPull&lt;br&gt;Enterprise private registry&lt;br&gt;requires Premium" style="fontFamily=Segoe UI;html=1;whiteSpace=wrap;text;align=left;verticalAlign=top;spacing=0;fontSize=14;fontColor=#B7C8DA;fontStyle=0;">
          <mxGeometry x="76" y="39" width="250" height="76" as="geometry" />
        </mxCell>
        <mxCell id="entry-icon" parent="entry" vertex="1" style="fontFamily=Segoe UI;html=1;whiteSpace=wrap;shape=image;aspect=fixed;imageAspect=1;image=data:image/svg+xml,;">
          <mxGeometry x="14" y="14" width="48" height="48" as="geometry" />
        </mxCell>
        <mxCell id="entry-title" parent="entry" vertex="1" value="Start one job execution" style="fontFamily=Segoe UI;html=1;whiteSpace=wrap;text;align=left;verticalAlign=top;spacing=0;fontSize=18;fontColor=#EDF5FF;fontStyle=1;">
          <mxGeometry x="76" y="12" width="550" height="23" as="geometry" />
        </mxCell>
        <mxCell id="entry-body" parent="entry" vertex="1" value="Python 3.11 / CPU torch; 2 vCPU / 4 GiB&lt;br&gt;python -m aurora_pipeline.run&lt;br&gt;Managed identity selected with AZURE_CLIENT_ID&lt;br&gt;One cycle -&amp;gt; exit; timeout 3600 s / retry limit 1" style="fontFamily=Segoe UI;html=1;whiteSpace=wrap;text;align=left;verticalAlign=top;spacing=0;fontSize=15;fontColor=#B7C8DA;fontStyle=0;">
          <mxGeometry x="76" y="40" width="550" height="80" as="geometry" />
        </mxCell>
        <mxCell id="prepare-icon" parent="prepare" vertex="1" style="fontFamily=Segoe UI;html=1;whiteSpace=wrap;shape=image;aspect=fixed;imageAspect=1;image=data:image/svg+xml,;">
          <mxGeometry x="14" y="14" width="48" height="48" as="geometry" />
        </mxCell>
        <mxCell id="prepare-title" parent="prepare" vertex="1" value="Prepare two starting weather states" style="fontFamily=Segoe UI;html=1;whiteSpace=wrap;text;align=left;verticalAlign=top;spacing=0;fontSize=18;fontColor=#EDF5FF;fontStyle=1;">
          <mxGeometry x="76" y="12" width="550" height="23" as="geometry" />
        </mxCell>
        <mxCell id="prepare-body" parent="prepare" vertex="1" value="config.py + initial_conditions.py&lt;br&gt;Temperature / wind / pressure / humidity; 13 pressure levels&lt;br&gt;GFS unit/grid conversion + standard static fields&lt;br&gt;Example: 13 UTC run uses 00 and 06 UTC snapshots" style="fontFamily=Segoe UI;html=1;whiteSpace=wrap;text;align=left;verticalAlign=top;spacing=0;fontSize=15;fontColor=#B7C8DA;fontStyle=0;">
          <mxGeometry x="76" y="40" width="550" height="80" as="geometry" />
        </mxCell>
        <mxCell id="invoke-icon" parent="invoke" vertex="1" style="fontFamily=Segoe UI;html=1;whiteSpace=wrap;shape=image;aspect=fixed;imageAspect=1;image=data:image/svg+xml,;">
          <mxGeometry x="14" y="14" width="48" height="48" as="geometry" />
        </mxCell>
        <mxCell id="invoke-title" parent="invoke" vertex="1" value="Detect, filter and submit forecast" style="fontFamily=Segoe UI;html=1;whiteSpace=wrap;text;align=left;verticalAlign=top;spacing=0;fontSize=18;fontColor=#EDF5FF;fontStyle=1;">
          <mxGeometry x="76" y="12" width="550" height="23" as="geometry" />
        </mxCell>
        <mxCell id="invoke-body" parent="invoke" vertex="1" value="tracking.py / nhc.py / inference.py&lt;br&gt;Pressure minima + nearby strong winds -&amp;gt; candidate centres&lt;br&gt;NHC matching / fallback filter -&amp;gt; official aurora.Tracker seeds&lt;br&gt;Request aurora-0.25-finetuned, 20 six-hour steps" style="fontFamily=Segoe UI;html=1;whiteSpace=wrap;text;align=left;verticalAlign=top;spacing=0;fontSize=15;fontColor=#B7C8DA;fontStyle=0;">
          <mxGeometry x="76" y="40" width="550" height="80" as="geometry" />
        </mxCell>
        <mxCell id="normalize-icon" parent="normalize" vertex="1" style="fontFamily=Segoe UI;html=1;whiteSpace=wrap;shape=image;aspect=fixed;imageAspect=1;image=data:image/svg+xml,;">
          <mxGeometry x="14" y="14" width="48" height="48" as="geometry" />
        </mxCell>
        <mxCell id="normalize-title" parent="normalize" vertex="1" value="Track and normalize for OneGrid" style="fontFamily=Segoe UI;html=1;whiteSpace=wrap;text;align=left;verticalAlign=top;spacing=0;fontSize=18;fontColor=#EDF5FF;fontStyle=1;">
          <mxGeometry x="76" y="12" width="550" height="23" as="geometry" />
        </mxCell>
        <mxCell id="normalize-body" parent="normalize" vertex="1" value="Follow each seed through returned weather fields&lt;br&gt;Starting position/intensity is from the input analysis&lt;br&gt;Forecast positions / winds / pressure from rollout&lt;br&gt;Convert units, movement and categories; publish events" style="fontFamily=Segoe UI;html=1;whiteSpace=wrap;text;align=left;verticalAlign=top;spacing=0;fontSize=15;fontColor=#B7C8DA;fontStyle=0;">
          <mxGeometry x="76" y="40" width="550" height="80" as="geometry" />
        </mxCell>
        <mxCell id="model-icon" parent="model" vertex="1" style="fontFamily=Segoe UI;html=1;whiteSpace=wrap;shape=image;aspect=fixed;imageAspect=1;image=data:image/svg+xml,;">
          <mxGeometry x="14" y="14" width="48" height="48" as="geometry" />
        </mxCell>
        <mxCell id="model-title" parent="model" vertex="1" value="Model deployment and backing resources" style="fontFamily=Segoe UI;html=1;whiteSpace=wrap;text;align=left;verticalAlign=top;spacing=0;fontSize=18;fontColor=#EDF5FF;fontStyle=1;">
          <mxGeometry x="76" y="12" width="930" height="23" as="geometry" />
        </mxCell>
        <mxCell id="model-body" parent="model" vertex="1" value="Workspace + endpoint existence is not model readiness: model asset / accepted terms / GPU quota / healthy&lt;br&gt;deployment required.&lt;br&gt;Default GPU: Standard_NC24ads_A100_v4; model selection is separate from the CPU image.&lt;br&gt;Workspace identity, endpoint identity, AML backing storage, Key Vault and Application Insights have distinct&lt;br&gt;lifecycle/permissions.&lt;br&gt;Validate artifact pulls and required backing-resource roles; don&amp;#x27;t treat resource wiring as a completed&lt;br&gt;permissions test." style="fontFamily=Segoe UI;html=1;whiteSpace=wrap;text;align=left;verticalAlign=top;spacing=0;fontSize=15;fontColor=#B7C8DA;fontStyle=0;">
          <mxGeometry x="76" y="40" width="930" height="140" as="geometry" />
        </mxCell>
        <mxCell id="ml-egress-icon" parent="ml-egress" vertex="1" style="fontFamily=Segoe UI;html=1;whiteSpace=wrap;shape=image;aspect=fixed;imageAspect=1;image=data:image/svg+xml,;">
          <mxGeometry x="14" y="14" width="48" height="48" as="geometry" />
        </mxCell>
        <mxCell id="ml-egress-title" parent="ml-egress" vertex="1" value="Managed deployment outbound network" style="fontFamily=Segoe UI;html=1;whiteSpace=wrap;text;align=left;verticalAlign=top;spacing=0;fontSize=18;fontColor=#EDF5FF;fontStyle=1;">
          <mxGeometry x="76" y="12" width="930" height="23" as="geometry" />
        </mxCell>
        <mxCell id="ml-egress-body" parent="ml-egress" vertex="1" value="For private enterprise operation: configure allowed outbound managed private endpoints / approved&lt;br&gt;destinations.&lt;br&gt;Include the customer Blob channel as well as ML backing storage / Key Vault / image artifacts.&lt;br&gt;A user-delegation SAS authorizes Blob operations; it does not bypass a storage firewall.&lt;br&gt;This policy is not the Container Apps environment subnet or App Service VNet integration." style="fontFamily=Segoe UI;html=1;whiteSpace=wrap;text;align=left;verticalAlign=top;spacing=0;fontSize=15;fontColor=#B7C8DA;fontStyle=0;">
          <mxGeometry x="76" y="40" width="930" height="100" as="geometry" />
        </mxCell>
        <mxCell id="gpu-icon" parent="gpu" vertex="1" style="fontFamily=Segoe UI;html=1;whiteSpace=wrap;shape=image;aspect=fixed;imageAspect=1;image=data:image/svg+xml,;">
          <mxGeometry x="14" y="14" width="48" height="48" as="geometry" />
        </mxCell>
        <mxCell id="gpu-title" parent="gpu" vertex="1" value="Aurora managed online endpoint" style="fontFamily=Segoe UI;html=1;whiteSpace=wrap;text;align=left;verticalAlign=top;spacing=0;fontSize=18;fontColor=#EDF5FF;fontStyle=1;">
          <mxGeometry x="76" y="12" width="930" height="23" as="geometry" />
        </mxCell>
        <mxCell id="gpu-body" parent="gpu" vertex="1" value="Job -&amp;gt; workspace PE -&amp;gt; supplied scoring hostname / HTTPS 443&lt;br&gt;Endpoint authMode = AADToken; job token audience https://ml.azure.com&lt;br&gt;Template job grant: AzureML Data Scientist on workspace&lt;br&gt;Aurora predicts atmospheric fields; model is not trained anew per execution" style="fontFamily=Segoe UI;html=1;whiteSpace=wrap;text;align=left;verticalAlign=top;spacing=0;fontSize=15;fontColor=#B7C8DA;fontStyle=0;">
          <mxGeometry x="76" y="40" width="930" height="80" as="geometry" />
        </mxCell>
        <mxCell id="channel-icon" parent="channel" vertex="1" style="fontFamily=Segoe UI;html=1;whiteSpace=wrap;shape=image;aspect=fixed;imageAspect=1;image=data:image/svg+xml,;">
          <mxGeometry x="14" y="14" width="48" height="48" as="geometry" />
        </mxCell>
        <mxCell id="channel-title" parent="channel" vertex="1" value="aurora-channel" style="fontFamily=Segoe UI;html=1;whiteSpace=wrap;text;align=left;verticalAlign=top;spacing=0;fontSize=18;fontColor=#EDF5FF;fontStyle=1;">
          <mxGeometry x="76" y="12" width="390" height="23" as="geometry" />
        </mxCell>
        <mxCell id="channel-body" parent="channel" vertex="1" value="Job creates short-lived user-delegation SAS&lt;br&gt;Large starting conditions and predicted fields&lt;br&gt;Endpoint and job both need reachable Blob path&lt;br&gt;Job: Storage Blob Data Contributor" style="fontFamily=Segoe UI;html=1;whiteSpace=wrap;text;align=left;verticalAlign=top;spacing=0;fontSize=15;fontColor=#B7C8DA;fontStyle=0;">

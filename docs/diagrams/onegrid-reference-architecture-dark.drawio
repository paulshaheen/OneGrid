        <mxCell id="trigger-body" parent="trigger" vertex="1" value="01 / 07 / 13 / 19 UTC&lt;br&gt;Optional app -&amp;gt; ARM job API&lt;br&gt;Job-scoped Jobs Operator&lt;br&gt;No inbound HTTP listener" style="fontFamily=Segoe UI;html=1;whiteSpace=wrap;text;align=left;verticalAlign=top;spacing=0;fontSize=15;fontColor=#B7C8DA;fontStyle=0;">

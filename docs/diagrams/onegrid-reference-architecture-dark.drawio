        <mxCell id="dns-test-title" parent="dns-test" vertex="1" value="Acceptance from every real caller" style="fontFamily=Segoe UI;html=1;whiteSpace=wrap;text;align=left;verticalAlign=top;spacing=0;fontSize=24;fontColor=#EDF5FF;fontStyle=1;">

  <diagram id="onegrid-reference-fabric-dark" name="OneGrid - Fabric ingestion, serving and source security">
    <mxGraphModel dx="2400" dy="2300" grid="1" gridSize="10" guides="1" connect="1" page="1" pageScale="1" pageWidth="2400" pageHeight="2300" background="#10161D">
      <root>

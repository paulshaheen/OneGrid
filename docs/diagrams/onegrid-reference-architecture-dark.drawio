        <mxCell id="weather-caveats-title" parent="weather-caveats" vertex="1" value="Forecast-derived values versus application estimates" style="fontFamily=Segoe UI;html=1;whiteSpace=wrap;text;align=left;verticalAlign=top;spacing=0;fontSize=24;fontColor=#EDF5FF;fontStyle=1;">

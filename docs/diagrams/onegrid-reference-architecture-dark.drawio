            <mxGeometry x="540" y="870" width="640" height="220" as="geometry" />
          </mxCell>
        </object>
        <object id="job-scope" label="" tooltip="Forecast-only execution permissions&#10;Template: AzureML Data Scientist on workspace; Storage Blob Data Contributor on sample account.&#10;Auto-created registry grants AcrPull to this identity. Supplied registries need their explicit pull grant. SAS and RBAC still require reachable network paths.">
          <mxCell parent="1" vertex="1" style="fontFamily=Segoe UI;html=1;whiteSpace=wrap;rounded=1;arcSize=5;container=1;collapsible=0;fillColor=#0F171F;strokeColor=#416780;strokeWidth=1.5;dashed=0;">

          <mxGeometry relative="1" as="geometry">
            <mxPoint x="810" y="194" as="sourcePoint" />
            <mxPoint x="927" y="194" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="onegrid-reference-naming:label-split-0" value="split" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=nowrap;fontSize=12;fontColor=#4D5D6A;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="860.519" y="174" width="31.9616" height="16" as="geometry" />
        </mxCell>
        <mxCell id="onegrid-reference-naming:footnote" value="Left: names as main.bicep and the provisioner resolve them. Right: a recommendation with illustrative Cloud Adoption Framework names; the template does not deploy it." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;fontSize=12.5;fontColor=#4D5D6A;fontStyle=0;" vertex="1" parent="1">

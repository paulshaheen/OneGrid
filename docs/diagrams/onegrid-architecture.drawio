        </mxCell>
        <mxCell id="onegrid-reference-baseline:subtitle" value="Operational, business, weather and geospatial data flow through Microsoft Fabric and Azure into one asset-intelligence web app and its AI agent." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;fontSize=14;fontColor=#4D5D6A;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="58" width="1720" height="22" as="geometry" />
